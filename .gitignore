# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local debug/check screenshots (not for repo)
vercel-check.png
*-check.png

# Claude Code local dev config
# 디렉토리째(.claude/) 제외하면 하위 예외(!)가 먹지 않는다 — 그래서 내용만 제외한다.
.claude/*

# claude local settings
.claude/settings.local.json

# 예외 — BMAD 스킬은 로컬 설정이 아니라 팀 공유 방법론이다.
# Codex 쪽(.agents/skills)은 추적되므로 이쪽도 추적해야 두 에이전트가 같은 것을 본다.
!.claude/skills/

# Orca 워크트리 드롭 폴더 (에이전트 전달용 원본 — 배포물 아님)
.orca/

# BMAD — 스킬 안 테스트 스크립트가 만드는 캐시, 개인 설정
__pycache__/
*.pyc
.pytest_cache/
_bmad/custom/*.user.toml

# BMAD 스킬은 전역 한 벌(~/.agents/skills)을 쓴다 — 레포에 복제하지 않는다.
# 레포에 필요한 것은 _bmad/ 뿐이다.
.claude/skills/bmad-*
.agents/skills/bmad-*
